OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Both must support tool-calling AND response_format. Verified against the live
# OpenRouter catalogue on 2026-08-15. Third option: openai/gpt-oss-20b:free
# Avoid nemotron-3-ultra-550b-a55b:free here — it has no response_format support.
OPENROUTER_LLM_PRIMARY=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_LLM_FALLBACK=google/gemma-4-26b-a4b-it:free

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free

TAVILY_API_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. IANA zone used by the injected current-date context. Defaults to UTC.
PROMPTLY_TIMEZONE=UTC

# Public site origin, no trailing slash. Substituted into index.html at build time for
# the canonical link, Open Graph and Twitter tags. Must be the real deployed URL or
# social previews and canonicalisation will point at the wrong place.
VITE_SITE_URL=https://promptly-me-omega.vercel.app
